# Copier vers .env à la racine du projet (docker compose)
POSTGRES_USER=rh_user
POSTGRES_PASSWORD=rh_secret_change_me
POSTGRES_DB=rh_db
POSTGRES_PORT=5432

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# URL publique des webhooks (ngrok ou domaine)
WEBHOOK_URL=http://localhost:5678/

TZ=Europe/Paris

# Doit correspondre au credential JWT (HS256) dans n8n pour les nœuds « Vérifier Token »
JWT_SECRET=change-this-jwt-secret-min-32-chars!!

# Power BI (hors Docker — à configurer dans les credentials OAuth2 du nœud HTTP Request)
# POWER_BI_TENANT_ID=
# POWER_BI_CLIENT_ID=
# POWER_BI_CLIENT_SECRET=
